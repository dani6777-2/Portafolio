---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (key: string) => translations[lang][key] ?? translations.es[key] ?? key;

const roles = [
  {
    company: 'Starken',
    roleKey: 'exp.starken.title',
    periodKey: 'exp.starken.period',
    present: true,
    tags: ['golang', 'gcp', 'gke', 'cloud-run', 'jira'],
    bullets: ['exp.starken.1', 'exp.starken.2', 'exp.starken.3', 'exp.starken.4'],
    hash: 'f70d543',
  },
  {
    company: 'VR Group',
    roleKey: 'exp.vrg.title',
    periodKey: 'exp.vrg.period',
    present: false,
    tags: ['quarkus', 'panache', 'spring-boot', 'aws-s3', 'lambda'],
    bullets: ['exp.vrg.1', 'exp.vrg.2', 'exp.vrg.3'],
    hash: 'a3b8c12',
  },
  {
    company: 'Zurich Santander',
    roleKey: 'exp.zurich.title',
    periodKey: 'exp.zurich.period',
    present: false,
    tags: ['spring-boot', 'spring-cloud', 'gitlab-ci', 'maven'],
    bullets: ['exp.zurich.1', 'exp.zurich.2'],
    hash: '9e4f567',
  },
];

const education = [
  { name: t('exp.inacap.title'), org: t('exp.inacap.org'), period: t('exp.inacap.period'), bullet: t('exp.inacap.1') },
  { name: t('certs.forge'), org: t('certs.forge.meta'), period: 'feb 2024 · jul 2024', bullet: t('exp.forge.1') },
];
---

<section id="experience" class="py-16 sm:py-24">
  <div class="container-term">
    <p class="section-cmd">{t('exp.cmd')}</p>

    <!-- Git log style timeline -->
    <div class="border-l-2 border-term-dim ml-3 sm:ml-6 space-y-0">
      {roles.map((job, idx) => (
        <article class="relative pl-8 sm:pl-12 pb-10">
          <!-- Commit dot -->
          <div class={`absolute left-[-7px] top-1 w-3 h-3 border-2 ${job.present ? 'border-term-green bg-term-green' : 'border-term-dim bg-term-bg'}`}></div>

          <!-- Commit header -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-4 mb-3">
            <span class="text-term-yellow text-xs">{job.hash}</span>
            {job.present && (
              <span class="text-term-green text-xs border border-term-green px-1.5 py-0.5">
                {t('exp.present')}
              </span>
            )}
            <span class="text-term-dim text-xs">·</span>
            <span class="text-term-muted text-xs">{t(job.periodKey)}</span>
          </div>

          <!-- Company & role -->
          <h3 class="text-term-white font-bold text-xl sm:text-3xl mb-1">{job.company}</h3>
          <p class="text-term-cyan text-sm mb-3">{t(job.roleKey)}</p>

          <!-- Bullets as terminal output -->
          <ul class="space-y-2 mb-4">
            {job.bullets.map((bulletKey) => (
              <li class="text-term-text text-sm flex gap-2">
                <span class="text-term-green shrink-0">→</span>
                <span>{t(bulletKey)}</span>
              </li>
            ))}
          </ul>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5">
            {job.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Education -->
    <div class="mt-12">
      <p class="text-term-cyan text-xs uppercase tracking-wider mb-6">// {t('exp.edu')}</p>
      <div class="grid md:grid-cols-2 gap-6">
        {education.map((edu) => (
          <div class="border border-term-dim p-5 bg-term-card glow-hover">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <h4 class="text-term-white font-bold text-sm">{edu.name}</h4>
              <span class="text-term-muted text-xs shrink-0">{edu.period}</span>
            </div>
            <p class="text-term-green text-xs mb-2">{edu.org}</p>
            <p class="text-term-text text-xs">{edu.bullet}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
