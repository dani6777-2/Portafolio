---
import { translations, type Lang } from '../i18n/translations';
import CV from '../assets/img/MORALES_ARIAS_DANIEL_CV.pdf';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (key: string) => translations[lang][key] ?? translations.es[key] ?? key;

const details = [
  { label: t('connect.email.label'), value: 'daniel.morales23@outlook.cl', href: 'mailto:daniel.morales23@outlook.cl' },
  { label: t('connect.phone.label'), value: '+56 9 8130 9352', href: 'tel:+56981309352' },
  { label: t('connect.location.label'), value: t('connect.location') },
];
---

<section id="connect" class="py-16 sm:py-24 border-t border-term-dim">
  <div class="container-term">
    <p class="section-cmd">{t('connect.cmd')}</p>

    <h2 class="text-term-white font-extrabold text-4xl sm:text-6xl lg:text-7xl leading-none mb-4">
      {t('connect.headline')}<span class="text-term-green animate-blink">_</span>
    </h2>
    <p class="text-term-text text-sm max-w-xl mb-10">{t('connect.subtitle')}</p>

    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Details -->
      <div class="space-y-6">
        <ul class="space-y-4">
          {details.map((item) => (
            <li class="flex items-center gap-4">
              <span class="text-term-cyan text-xs w-20 shrink-0">{item.label}:</span>
              {item.href ? (
                <a href={item.href} class="link-term text-term-text text-sm">{item.value}</a>
              ) : (
                <span class="text-term-text text-sm">{item.value}</span>
              )}
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-3 pt-2">
          <a href="https://www.linkedin.com/in/daniel-23dma/" target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn"
            class="w-10 h-10 border border-term-dim flex items-center justify-center text-term-text hover:border-term-green hover:text-term-green transition-colors duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://github.com/Dani6777/" target="_blank" rel="me noopener noreferrer" aria-label="GitHub"
            class="w-10 h-10 border border-term-dim flex items-center justify-center text-term-text hover:border-term-green hover:text-term-green transition-colors duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <span class="text-term-dim text-xs ml-2">github.com/Dani6777</span>
        </div>
      </div>

      <!-- Action cards -->
      <div class="space-y-3">
        <a href="mailto:daniel.morales23@outlook.cl"
          class="w-full p-4 border border-term-dim bg-term-card flex items-center gap-3 text-term-white text-sm hover:border-term-green hover:text-term-green glow-hover transition-all duration-200">
          <span class="text-term-green">$</span> open mailto:daniel.morales23@outlook.cl
        </a>
        <a href="https://www.linkedin.com/in/daniel-23dma/" target="_blank" rel="noopener noreferrer"
          class="w-full p-4 border border-term-dim bg-term-card flex items-center gap-3 text-term-white text-sm hover:border-term-cyan hover:text-term-cyan transition-all duration-200">
          <span class="text-term-green">$</span> open linkedin
        </a>
        <a href="https://github.com/Dani6777/" target="_blank" rel="noopener noreferrer"
          class="w-full p-4 border border-term-dim bg-term-card flex items-center gap-3 text-term-white text-sm hover:border-term-cyan hover:text-term-cyan transition-all duration-200">
          <span class="text-term-green">$</span> open github
        </a>
        <a href={CV} download="MORALES_ARIAS_DANIEL_CV.pdf"
          class="w-full p-4 border border-term-dim bg-term-card flex items-center gap-3 text-term-white text-sm hover:border-term-green hover:text-term-green transition-all duration-200">
          <span class="text-term-green">$</span> {t('connect.cv')}
        </a>
      </div>
    </div>
  </div>
</section>
